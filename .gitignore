# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example template, which is safe (placeholders only) and needed for setup
!.env.example

# vercel
.vercel

# uploaded product images (generated at runtime via /api/admin/upload)
/public/uploads/*
!/public/uploads/.gitkeep

# local dev artifacts
dev.log
.pgdata/

# typescript
*.tsbuildinfo
next-env.d.ts
