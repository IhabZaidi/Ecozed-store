# --- Database (local Postgres) ---
# Create a database named ecozed, then point here:
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ecozed"
# Or via Docker (see docker-compose.yml): docker compose up -d db

# --- Admin (simple password auth) ---
ADMIN_PASSWORD="change-me-strong-password"
ADMIN_SESSION_SECRET="generate-32-char-random-string"

# --- Site (server-only; never exposed to the browser) ---
SITE_URL="http://localhost:3000"
# NOTE: Pixel / Telegram / Sheets / Clarity are configured in /admin settings (DB).
# Their env vars remain supported as fallback but are intentionally unset here.
# NEXT_PUBLIC_CLARITY_ID="xxxxx"   # optional: Microsoft Clarity (empty = never loads)
# Production uploads (Vercel has no writable disk): create a Blob store in
# Vercel → Storage; it injects BLOB_READ_WRITE_TOKEN automatically.
# Local dev needs nothing (files go to public/uploads).

# --- Local testing only (never set in production) ---
# DISABLE_OUTBOUND=1  # CAPI + Telegram never leave the machine (orders still save)
