# --- Database (local Postgres) ---
# Create a database named ecozed, then point here:
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ecozed"
# Or via Docker (see docker-compose.yml): docker compose up -d db

# --- Admin (simple password auth) ---
ADMIN_PASSWORD="change-me-strong-password"
ADMIN_SESSION_SECRET="generate-32-char-random-string"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# NOTE: Pixel / Telegram / Sheets are configured in /admin settings (DB).
# Their env vars remain supported as fallback but are intentionally unset here.
